diff --git a/srcs/internal/client/client_monetdb.cc b/srcs/internal/client/client_monetdb.cc
new file mode 100644
index 0000000..6851291
--- /dev/null
+++ b/srcs/internal/client/client_monetdb.cc
@@ -0,0 +1,134 @@
+#include "client_monetdb.h"
+
+#include <fcntl.h>
+#include <signal.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <chrono>
+#include <cstdlib>
+#include <string>
+
+namespace {
+
+int wait_for_process(pid_t pid, int timeout_seconds) {
+  const auto deadline = std::chrono::steady_clock::now()
+                        + std::chrono::seconds(timeout_seconds);
+  int status = 0;
+  while (true) {
+    const pid_t result = waitpid(pid, &status, WNOHANG);
+    if (result == pid) {
+      if (WIFEXITED(status)) return WEXITSTATUS(status);
+      if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);
+      return 1;
+    }
+    if (result < 0) return 1;
+    if (std::chrono::steady_clock::now() >= deadline) {
+      kill(pid, SIGKILL);
+      waitpid(pid, &status, 0);
+      return -2;
+    }
+    usleep(10000);
+  }
+}
+
+}  // namespace
+
+namespace client {
+
+void MonetDBClient::initialize(YAML::Node config) {
+  mclient_path_ = config["mclient"]
+                      ? config["mclient"].as<std::string>()
+                      : "/opt/monetdb/bin/mclient";
+  port_ = config["port"] ? config["port"].as<std::string>() : "50000";
+  schema_ = config["schema"] ? config["schema"].as<std::string>() : "squirrel";
+  auth_file_ = config["auth_file"]
+                   ? config["auth_file"].as<std::string>()
+                   : "/tmp/squirrel-monetdb.auth";
+  if (config["timeout_seconds"]) {
+    timeout_seconds_ = config["timeout_seconds"].as<int>();
+  }
+
+  const int auth_fd = open(auth_file_.c_str(), O_WRONLY | O_CREAT | O_TRUNC,
+                           0600);
+  if (auth_fd >= 0) {
+    const char auth[] = "user=monetdb\npassword=monetdb\n";
+    write(auth_fd, auth, sizeof(auth) - 1);
+    close(auth_fd);
+  }
+  setenv("DOTMONETDBFILE", auth_file_.c_str(), 1);
+}
+
+int MonetDBClient::run_mclient(const std::string *input_file,
+                               const std::string *query) const {
+  const pid_t pid = fork();
+  if (pid < 0) return 1;
+
+  if (pid == 0) {
+    if (input_file != nullptr) {
+      const int input = open(input_file->c_str(), O_RDONLY);
+      if (input < 0 || dup2(input, STDIN_FILENO) < 0) _exit(127);
+      close(input);
+    }
+    const int output = open("/dev/null", O_WRONLY);
+    if (output >= 0) {
+      dup2(output, STDOUT_FILENO);
+      dup2(output, STDERR_FILENO);
+      close(output);
+    }
+
+    const char *client = mclient_path_.c_str();
+    const char *port = port_.c_str();
+    if (query != nullptr) {
+      execl(client, client, "-p", port, "-s", query->c_str(), nullptr);
+    } else {
+      execl(client, client, "-p", port, "-f", "sql", nullptr);
+    }
+    _exit(127);
+  }
+
+  return wait_for_process(pid, timeout_seconds_);
+}
+
+void MonetDBClient::prepare_env() {
+  const std::string drop = "DROP SCHEMA \"" + schema_ + "\" CASCADE;";
+  const std::string create = "CREATE SCHEMA \"" + schema_ + "\";";
+  const std::string set = "SET SCHEMA \"" + schema_ + "\";";
+  // The DROP is intentionally allowed to fail when this is the first input.
+  run_mclient(nullptr, &drop);
+  run_mclient(nullptr, &create);
+  run_mclient(nullptr, &set);
+}
+
+ExecutionStatus MonetDBClient::execute(const char *query, size_t size) {
+  char path[] = "/tmp/squirrel-monetdb-query-XXXXXX";
+  const int fd = mkstemp(path);
+  if (fd < 0) return kExecuteError;
+
+  size_t written = 0;
+  while (written < size) {
+    const ssize_t count = write(fd, query + written, size - written);
+    if (count <= 0) {
+      close(fd);
+      unlink(path);
+      return kExecuteError;
+    }
+    written += static_cast<size_t>(count);
+  }
+  close(fd);
+
+  const std::string input_file(path);
+  const int result = run_mclient(&input_file, nullptr);
+  unlink(path);
+  if (result == -2) return kTimeout;
+  if (result == 0) return kNormal;
+  if (!check_alive()) return kServerCrash;
+  return kExecuteError;
+}
+
+bool MonetDBClient::check_alive() {
+  const std::string probe = "SELECT 1;";
+  return run_mclient(nullptr, &probe) == 0;
+}
+
+}  // namespace client
diff --git a/srcs/internal/client/client_monetdb.h b/srcs/internal/client/client_monetdb.h
new file mode 100644
index 0000000..1f173ec
--- /dev/null
+++ b/srcs/internal/client/client_monetdb.h
@@ -0,0 +1,32 @@
+#ifndef __CLIENT_MONETDB_H__
+#define __CLIENT_MONETDB_H__
+
+#include <cstddef>
+#include <string>
+
+#include "client.h"
+#include "yaml-cpp/yaml.h"
+
+namespace client {
+
+class MonetDBClient : public DBClient {
+ public:
+  void initialize(YAML::Node config) override;
+  void prepare_env() override;
+  ExecutionStatus execute(const char *query, size_t size) override;
+  bool check_alive() override;
+
+ private:
+  int run_mclient(const std::string *input_file,
+                  const std::string *query) const;
+
+  std::string mclient_path_;
+  std::string port_;
+  std::string schema_;
+  std::string auth_file_;
+  int timeout_seconds_ = 60;
+};
+
+}  // namespace client
+
+#endif
