+static string sqlaser_trim(const string &s) {
+
+  size_t begin = 0, end = s.size();
+  while (begin < end && isspace((unsigned char)s[begin]))
+    begin++;
+  while (end > begin && isspace((unsigned char)s[end - 1]))
+    end--;
+  return s.substr(begin, end - begin);
+}
+
+static string sqlaser_lower(string s) {
+
+  transform(s.begin(), s.end(), s.begin(), [](unsigned char c) {
+    return (char)tolower(c);
+  });
+  return s;
+}
+
+static vector<string> sqlaser_split(const string &s, char sep) {
+
+  vector<string> parts;
+  string item;
+  stringstream ss(s);
+
+  while (getline(ss, item, sep)) {
+    item = sqlaser_trim(item);
+    if (!item.empty())
+      parts.push_back(sqlaser_lower(item));
+  }
+
+  return parts;
+}
+
+static u8 sqlaser_env_enabled(const char *value) {
+
+  if (!value)
+    return 0;
+
+  string v = sqlaser_lower(sqlaser_trim(value));
+  return v == "1" || v == "true" || v == "yes" || v == "on";
+}
+
+static string sqlaser_read_file(u8 *path) {
+
+  if (!path)
+    return "";
+
+  ifstream in((char *)path, ios::in | ios::binary);
+  if (!in)
+    return "";
+
+  stringstream buffer;
+  buffer << in.rdbuf();
+  return buffer.str();
+}
+
+static u32 sqlaser_energy_for(u32 distance, u32 progress, u32 weight) {
+
+  u32 rounds = 1;
+
+  if (distance == 0)
+    rounds = 4;
+  else if (distance == 1)
+    rounds = 3;
+  else if (distance == 2)
+    rounds = 2;
+  else if (progress)
+    rounds = 2;
+
+  rounds *= MAX(1, weight);
+  if (rounds > 6)
+    rounds = 6;
+
+  return rounds;
+}
+
+static void sqlaser_load_targets(void) {
+
+  const char *path_env = getenv("SQLASER_TARGETS");
+  sqlaser_targets_path = path_env ? path_env : "./sqlaser/mysql_target_chains.tsv";
+
+  ifstream in(sqlaser_targets_path);
+  if (!in) {
+    WARNF("SQLaser enabled but target file not found: %s",
+          sqlaser_targets_path.c_str());
+    sqlaser_enabled = 0;
+    return;
+  }
+
+  string line;
+  while (getline(in, line)) {
+
+    line = sqlaser_trim(line);
+    if (line.empty() || line[0] == '#')
+      continue;
+
+    vector<string> cols;
+    string col;
+    stringstream ss(line);
+    while (getline(ss, col, '\t'))
+      cols.push_back(sqlaser_trim(col));
+
+    if (cols.size() < 5)
+      continue;
+
+    string enabled = sqlaser_lower(cols[4]);
+    if (!(enabled == "1" || enabled == "true" || enabled == "yes"))
+      continue;
+
+    sqlaser_target_chain target;
+    target.pattern_id = cols[0];
+    target.clause_chain = sqlaser_split(cols[1], '|');
+    target.target_call_chain = sqlaser_split(cols[2], '|');
+    target.weight = (u32)MAX(1, atoi(cols[3].c_str()));
+
+    if (!target.clause_chain.empty())
+      sqlaser_targets.push_back(target);
+  }
+
+  if (sqlaser_targets.empty()) {
+    WARNF("SQLaser enabled but no active target chains were loaded.");
+    sqlaser_enabled = 0;
+    return;
+  }
+
+  OKF("SQLaser loaded %zu MySQL target chains from %s",
+      sqlaser_targets.size(), sqlaser_targets_path.c_str());
+}
+
+static void sqlaser_configure_from_env(void) {
+
+  const char *enabled_env = getenv("SQLASER_ENABLED");
+  if (!enabled_env)
+    enabled_env = getenv("SQLASER_ENABLE");
+
+  sqlaser_enabled = sqlaser_env_enabled(enabled_env);
+  if (!sqlaser_enabled)
+    return;
+
+  sqlaser_load_targets();
+}
+
+static FILE *sqlaser_open_seed_meta_file(void) {
+
+  if (!sqlaser_enabled || !out_dir)
+    return NULL;
+
+  if (sqlaser_seed_meta_file)
+    return sqlaser_seed_meta_file;
+
+  u8 *path = alloc_printf("%s/sqlaser_seed_metadata.tsv", out_dir);
+  struct stat st;
+  u8 need_header = stat((char *)path, &st) || st.st_size == 0;
+
+  sqlaser_seed_meta_file = fopen((char *)path, "a");
+  if (!sqlaser_seed_meta_file) {
+    WARNF("Unable to create SQLaser seed metadata log: %s", path);
+    ck_free(path);
+    return NULL;
+  }
+
+  if (need_header)
+    fprintf(sqlaser_seed_meta_file,
+            "queue_file\tsource\tpattern_id\tprogress\tchain_len\tdistance\tweight\tenergy\n");
+
+  ck_free(path);
+  return sqlaser_seed_meta_file;
+}
+
+static void sqlaser_score_queue_entry(struct queue_entry *q,
+                                      const string &query,
+                                      const char *source) {
+
+  if (!sqlaser_enabled || !q || query.empty() || sqlaser_targets.empty())
+    return;
+
+  string lower_query = sqlaser_lower(query);
+  u32 best_target = 0xffffffffu;
+  u32 best_progress = 0;
+  u32 best_len = 0;
+  u32 best_distance = 0xffffffffu;
+
+  for (u32 i = 0; i < sqlaser_targets.size(); i++) {
+
+    const sqlaser_target_chain &target = sqlaser_targets[i];
+    size_t pos = 0;
+    u32 progress = 0;
+
+    for (const string &clause : target.clause_chain) {
+
+      size_t found = lower_query.find(clause, pos);
+      if (found == string::npos)
+        break;
+
+      progress++;
+      pos = found + clause.size();
+    }
+
+    u32 chain_len = target.clause_chain.size();
+    u32 distance = chain_len - progress;
+    if (!progress)
+      distance++;
+
+    if (distance < best_distance ||
+        (distance == best_distance && progress > best_progress)) {
+      best_target = i;
+      best_progress = progress;
+      best_len = chain_len;
+      best_distance = distance;
+    }
+  }
+
+  if (best_target == 0xffffffffu)
+    return;
+
+  q->sqlaser_has_meta = 1;
+  q->sqlaser_target_id = best_target;
+  q->sqlaser_chain_progress = best_progress;
+  q->sqlaser_chain_len = best_len;
+  q->sqlaser_distance = best_distance;
+  q->sqlaser_energy = sqlaser_energy_for(
+      best_distance, best_progress, sqlaser_targets[best_target].weight);
+
+  sqlaser_total_scored++;
+  if (best_progress)
+    sqlaser_progress_seeds++;
+  if (best_distance == 0)
+    sqlaser_chain_hits++;
+  if (best_progress > sqlaser_best_progress)
+    sqlaser_best_progress = best_progress;
+  if (best_distance < sqlaser_best_distance)
+    sqlaser_best_distance = best_distance;
+
+  FILE *meta = sqlaser_open_seed_meta_file();
+  if (meta) {
+    const sqlaser_target_chain &target = sqlaser_targets[best_target];
+    fprintf(meta, "%s\t%s\t%s\t%u\t%u\t%u\t%u\t%u\n",
+            q->fname ? (char *)q->fname : "",
+            source ? source : "unknown",
+            target.pattern_id.c_str(), best_progress, best_len, best_distance,
+            target.weight, q->sqlaser_energy);
+    fflush(meta);
+  }
+}
+
+static u32 sqlaser_energy_rounds(struct queue_entry *q) {
+
+  if (!sqlaser_enabled || !q || !q->sqlaser_has_meta || !q->sqlaser_chain_len ||
+      q->sqlaser_target_id >= sqlaser_targets.size())
+    return 1;
+
+  u32 rounds = q->sqlaser_energy;
+  if (!rounds)
+    rounds = sqlaser_energy_for(q->sqlaser_distance,
+                                q->sqlaser_chain_progress,
+                                sqlaser_targets[q->sqlaser_target_id].weight);
+
+  if (rounds > 6)
+    rounds = 6;
+  if (rounds > 1)
+    sqlaser_energy_boosts++;
+  sqlaser_energy_counts[rounds]++;
+
+  return rounds;
+}
