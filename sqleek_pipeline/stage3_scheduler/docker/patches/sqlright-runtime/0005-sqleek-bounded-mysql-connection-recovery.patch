+static unsigned sqleek_env_uint(const char *name, unsigned fallback)
+{
+  const char *value = getenv(name);
+  if (!value || !value[0])
+    return fallback;
+  char *endptr = NULL;
+  unsigned long parsed = strtoul(value, &endptr, 10);
+  if (endptr == value || parsed == 0)
+    return fallback;
+  return (unsigned)parsed;
+}
+
+static bool sqleek_restart_dbms_from_env()
+{
+  const char *script = getenv("SQLEEK_DBMS_RESTART_SCRIPT");
+  if (!script || !script[0])
+  {
+    cerr << "SQLeek DBMS restart requested but SQLEEK_DBMS_RESTART_SCRIPT is not set.\n";
+    return false;
+  }
+  cerr << "SQLeek restarting DBMS via " << script << "\n";
+  int rc = system(script);
+  if (rc != 0)
+  {
+    cerr << "SQLeek DBMS restart script failed with status " << rc << "\n";
+    return false;
+  }
+  return true;
+}
