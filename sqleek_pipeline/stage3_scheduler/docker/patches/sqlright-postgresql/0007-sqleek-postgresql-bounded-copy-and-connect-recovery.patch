+static int sqleek_env_int(const char *name, int fallback, int min_value)
+{
+  const char *value = getenv(name);
+  if (!value || !value[0]) return fallback;
+  char *endptr = NULL;
+  long parsed = strtol(value, &endptr, 10);
+  if (endptr == value || parsed < min_value) return fallback;
+  return (int)parsed;
+}
+
+static void sqleek_cancel_query(PGconn *conn)
+{
+  if (!conn) return;
+  PGcancel *cancel_conn = PQgetCancel(conn);
+  if (!cancel_conn) return;
+  char errbuf[512];
+  PQcancel(cancel_conn, errbuf, sizeof(errbuf));
+  PQfreeCancel(cancel_conn);
+}
