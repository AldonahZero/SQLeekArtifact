+static bool sqleek_sync_coverage_only_enabled(void) {
+  const char *value = getenv("SQLRIGHT_SYNC_COVERAGE_ONLY");
+  return value && value[0] && strcmp(value, "0");
+}
+
+/* MonetDB uses SQLRight's SQLite parser/IR mutator but does not have a
+   SQLite-compatible oracle result for seeds imported through AFL sync. Keep
+   the AFL coverage bookkeeping for synced seeds, but do not touch SQLRight's
+   oracle comparison result or SQLite-specific library metadata here. The seed
+   can still be selected by AFL later; fuzz_one() will parse it through the
+   normal mutation path when it is actually mutated. */
+static u8 save_if_interesting_coverage_only(char **argv, string &query_str, u8 fault) {
+  u8 *fn = "";
+  u8 hnb;
+  s32 fd;
+  u8 keeping = 0;
+
+  if (is_str_empty(query_str))
+    return keeping;
+
+  if (fault == crash_mode) {
+
+    if (!(hnb = has_new_bits(virgin_bits, query_str)) && !disable_coverage_feedback) {
+      if (crash_mode)
+        total_crashes++;
+      return keeping;
+    }
+
+    if (disable_coverage_feedback == 1)
+      return keeping;
+
+    if ((disable_coverage_feedback == 2) && get_rand_int(10) < 9)
+      return keeping;
+
+#ifndef SIMPLE_FILES
+
+    fn = alloc_printf("%s/queue/id:%06u,%s", out_dir, queued_paths,
+                      describe_op(hnb));
+
+#else
+
+    fn = alloc_printf("%s/queue/id_%06u", out_dir, queued_paths);
+
+#endif /* ^!SIMPLE_FILES */
+
+    add_to_queue(fn, query_str.size(), 0);
+    total_add_to_queue++;
+
+    if (hnb == 2) {
+      queue_top->has_new_cov = 1;
+      queued_with_cov++;
+    }
+
+    queue_top->exec_cksum = hash32(trace_bits, MAP_SIZE, HASH_CONST);
+
+    fd = open(fn, O_WRONLY | O_CREAT | O_EXCL, 0640);
+    if (fd < 0)
+      PFATAL("Unable to create '%s'", fn);
+    ck_write(fd, query_str.c_str(), query_str.size(), fn);
+    close(fd);
+
+    return 1;
+  }
+
+  ALL_COMP_RES unused_all_comp_res = ALL_COMP_RES();
+  return save_if_interesting(argv, query_str, unused_all_comp_res, fault);
+}
+
